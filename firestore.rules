rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.role == "admin" || request.auth.token.admin == true);
    }

    // Public intake, admin reads.
    match /requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Public intake, admin triage.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only payments collection.
    match /payment_requests/{paymentId} {
      allow create, read, update, delete: if isAdmin();
    }

    // Newsletter records are written by server routes through the Admin SDK.
    match /newsletter_subscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Newsletter campaign audit records are admin-only.
    match /newsletter_campaigns/{campaignId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Public registration submission.
    match /registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Public IEM registration submission.
    match /iem_registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Rentals are written by server routes (Admin SDK).
    match /rentals/{rentalId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Chat sessions — public create, admin read/update.
    match /chat_sessions/{sessionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
